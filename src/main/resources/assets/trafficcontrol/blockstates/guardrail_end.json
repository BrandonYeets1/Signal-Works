{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "trafficcontrol:block/guardrails/guardrail_end"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "trafficcontrol:block/guardrails/guardrail_end",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "trafficcontrol:block/guardrails/guardrail_end",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "trafficcontrol:block/guardrails/guardrail_end",
        "y": 270
      }
    }
  ]
}