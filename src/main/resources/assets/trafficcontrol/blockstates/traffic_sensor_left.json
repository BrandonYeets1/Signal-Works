{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "trafficcontrol:block/detection/traffic_sensor_left"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "trafficcontrol:block/detection/traffic_sensor_left",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "trafficcontrol:block/detection/traffic_sensor_left",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "trafficcontrol:block/detection/traffic_sensor_left",
        "y": 270
      }
    }
  ]
}
