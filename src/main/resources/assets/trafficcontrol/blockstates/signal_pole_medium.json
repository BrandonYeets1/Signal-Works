{
  "multipart": [
    {
      "when": {
        "base": "true"
      },
      "apply": {
        "model": "trafficcontrol:block/signal_pole_medium"
      }
    },
    {
      "when": {
        "base": "false"
      },
      "apply": {
        "model": "trafficcontrol:block/signal_pole_medium_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "trafficcontrol:block/signal_support_medium_branch"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "trafficcontrol:block/signal_support_medium_branch",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "trafficcontrol:block/signal_support_medium_branch",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "trafficcontrol:block/signal_support_medium_branch",
        "y": 270,
        "uvlock": true
      }
    }
  ]
}
